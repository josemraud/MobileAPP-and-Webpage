# One ignore list for API, DB, UI_MOBILE, and UI_WEB.

# --- Secrets and local config ---
.env
.env.*
!.env.example
local.properties
*.pem
*.pepk
*.jks
*.keystore
!debug.keystore

# --- OS junk ---
.DS_Store
.AppleDouble
.LSOverride
._*
__MACOSX/
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Editors and IDEs ---
.idea/
*.iml
inspectionProfiles/
workspace.xml
misc.xml
modules.xml
vcs.xml
.vscode/
*.swp
*~
.project
.classpath
.settings/

# --- Logs and coverage ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/
.nyc_output/
*.lcov

# --- Python (API) ---
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
env/
ENV/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
htmlcov/
instance/
.webassets-cache

# --- Node (UI_MOBILE and UI_WEB) ---
node_modules/
jspm_packages/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.eslintcache
.node_repl_history
.stylelintcache

# --- React web ---
/UI_WEB/build/

# --- React Native / Metro ---
.expo/
.expo-shared/
web-build/
dist/
*.jsbundle
*.bundle.map
.metro-health-check*
link-assets-manifest.json

